# Placeholders only. Server reads process environment; it does not load this file.
KAEW_DEVICE_TOKEN=replace-with-long-random-device-token
KAEW_ADMIN_TOKEN=replace-with-different-long-random-admin-token
KAEW_HOST=127.0.0.1
KAEW_PORT=8080
# Hosted TLS edge only: set host to 0.0.0.0 and trust flag to 1.
KAEW_TRUST_EDGE_HTTPS=0
# Unset/empty DATABASE_URL keeps stdlib-only SQLite. Hosted: set privately from
# the Supabase connection dialog (include sslmode=require); never commit the URI.
DATABASE_URL=
KAEW_DB_PATH=cloud/kaew.sqlite3
# Optional LAN HTTP experiment only, never the Render production path.
KAEW_DEV_ALLOW_INSECURE_LAN=0
# PORT is supplied by Render; leave KAEW_PORT unset there.
# Render runtime settings (local Python does not use PYTHON_VERSION):
PYTHON_VERSION=3.11.11
PYTHONDONTWRITEBYTECODE=1
# Optional: leave both blank for mock notifications.
KAEW_TELEGRAM_TOKEN=
KAEW_TELEGRAM_CHAT_ID=

# Optional local model adapter (not required for telemetry).
KAEW_OLLAMA_MODEL=

# Optional AI secrets; missing keys use a recorded 60-minute fallback, never fail startup.
GROQ_API_KEY=
# Optional secondary provider; same model id as Groq (availability may differ).
OPENROUTER_API_KEY=
# Non-secret; fast Groq production default for the live demo.
KAEW_AI_MODEL=openai/gpt-oss-20b

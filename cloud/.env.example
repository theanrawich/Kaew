# Placeholders only. Server reads process environment; it does not load this file.
KAEW_DEVICE_TOKEN=replace-with-long-random-device-token
KAEW_ADMIN_TOKEN=replace-with-different-long-random-admin-token
KAEW_HOST=127.0.0.1
KAEW_PORT=8080
# Hosted TLS edge only: set host to 0.0.0.0 and trust flag to 1.
KAEW_TRUST_EDGE_HTTPS=0
KAEW_DB_PATH=cloud/kaew.sqlite3
# Optional: leave both blank for mock notifications.
KAEW_TELEGRAM_TOKEN=
KAEW_TELEGRAM_CHAT_ID=
